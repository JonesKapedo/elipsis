# Elipsis environment configuration — copy to .env and fill in real values.
# Never commit .env.
#
# NOTE: legacy TURBINEZ_* names are still read as a fallback by main.py and
# config.py, so an existing .env keeps working.
ELIPSIS_ENV=development
ELIPSIS_TELEGRAM_TOKEN=
ELIPSIS_DATABASE_URL=postgresql://elipsis:password@localhost/elipsis_dev
ELIPSIS_REDIS_URL=redis://localhost:6379/0
ELIPSIS_SECRET_KEY=
