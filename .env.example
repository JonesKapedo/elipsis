# Elipsis environment configuration — copy to .env and fill in real values.
# Never commit .env.
#
# NOTE: legacy TURBINEZ_* names are still read as a fallback by main.py and
# config.py, so an existing .env keeps working.
ELIPSIS_ENV=development
ELIPSIS_TELEGRAM_TOKEN=
# Leave ELIPSIS_DATABASE_URL unset for local development: the app then uses the
# SQLite file (turbinez.db) beside the project and needs no database server.
# Set it to a PostgreSQL URL for a serverless deploy, where the filesystem is
# read-only and SQLite cannot be persisted.
# ELIPSIS_DATABASE_URL=postgresql://elipsis:password@localhost/elipsis_dev
ELIPSIS_REDIS_URL=redis://localhost:6379/0
ELIPSIS_SECRET_KEY=replace-with-a-long-random-string
# First administrator, created once when the users table is empty.
# Set both before exposing an instance; the sign-in page does not show them.
ELIPSIS_ADMIN_EMAIL=admin@elipsis.local
ELIPSIS_ADMIN_PASSWORD=change-me-before-going-live

# Paystack (required in production; dummy checkout is dev-only)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Optional: extra trusted origins, comma-separated
ELIPSIS_ALLOWED_ORIGINS=

# Optional: password reset / verification email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@elipsis.ai

# Marketplace is closed until vetted listings are ready (0/1)
ELIPSIS_MARKETPLACE_ENABLED=0

# Marketplace feature flags (1/0)
ELIPSIS_MESSAGING_ENABLED=1
ELIPSIS_BILLING_ENABLED=1
ELIPSIS_HANDOFF_ENABLED=1
ELIPSIS_VERIFICATION_ENABLED=1

# Partner handoff (server-to-server). Use a long random secret; it signs the
# short-lived handoff token. The fetch secret is shared with the partner.
ELIPSIS_HANDOFF_SECRET=
ELIPSIS_HANDOFF_FETCH_SECRET=
ELIPSIS_PARTNER_HANDOFF_URL=https://great-turbinez.vercel.app/from-elipsis

# Paystack recurring plan codes (create plans in the Paystack dashboard).
# When set, checkout creates an auto-renewing subscription. When blank, the
# same checkout remains a one-time pass.
PAYSTACK_PLAN_PREMIUM_MONTHLY=
PAYSTACK_PLAN_PREMIUM_ANNUAL=
PAYSTACK_PLAN_BIDDER_MONTHLY=
PAYSTACK_PLAN_BIDDER_SIX_MONTHS=
PAYSTACK_PLAN_BIDDER_YEARLY=
