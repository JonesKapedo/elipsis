{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/node"
    },
    {
      "src": "elipsis_api/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "elipsis_api.main:app"
    },
    {
      "src": "/(.)*",
      "dest": "frontend/dist/$1"
    }
  ],
  "env": {
    "ELIPSIS_DATABASE_URL": "postgresql://USER:PASSWORD@HOST/DATABASE",
    "ELIPSIS_ADMIN_EMAIL": "admin@elipsis.local",
    "ELIPSIS_ADMIN_PASSWORD": "change-me-now",
    "ELIPSIS_JWT_SECRET": ".env from vercel"
  },
  "envcli": {
    "ELIPSIS_DATABASE_URL": "postgresql://USER:PASSWORD@HOST/DATABASE",
    "ELIPSIS_ADMIN_PASSWORD": "Generate a strong password for the admin console",
    "ELIPSIS_JWT_SECRET": "Automatically generated by Vercel on first deploy"
  }
}
